{
  "$comment": "EXAMPLE CONFIG: replace the property names and SKUs with your own. Each calculator turns deal properties into line items. See README.md > Calculator config.",
  "settings": {
    "skipWhenQuoteExists": true,
    "syncWhen": "dealstage != \"closedwon\" && dealstage != \"closedlost\""
  },
  "calculators": [
    {
      "id": "marquee",
      "name": "Marquee calculator",
      "appliesWhen": "marquee_width_m > 0 && marquee_length_m > 0",
      "lineItems": [
        {
          "key": "structure",
          "$comment": "Priced per square metre; the calculator has already worked out the rate.",
          "product": { "sku": "MQ-STRUCTURE" },
          "quantity": "marquee_width_m * marquee_length_m",
          "unitPrice": "marquee_price_per_sqm",
          "name": "Marquee structure ({{marquee_width_m}}m x {{marquee_length_m}}m)"
        },
        {
          "key": "flooring",
          "product": { "sku": "MQ-FLOOR" },
          "includeWhen": "hasOption(marquee_extras, \"flooring\")",
          "quantity": "marquee_width_m * marquee_length_m"
        },
        {
          "key": "lighting",
          "$comment": "One lighting rig per 20 m2, rounded up.",
          "product": { "sku": "MQ-LIGHT" },
          "quantity": "ceil(marquee_width_m * marquee_length_m / 20)"
        },
        {
          "key": "installation",
          "$comment": "The calculator outputs a total; the app divides by quantity for the unit price.",
          "product": { "sku": "MQ-INSTALL" },
          "quantity": 1,
          "totalPrice": "marquee_install_cost"
        }
      ]
    },
    {
      "id": "furniture",
      "name": "Furniture calculator",
      "appliesWhen": "guest_count > 0",
      "lineItems": [
        {
          "key": "chairs",
          "product": { "sku": "FURN-CHAIR" },
          "quantity": "guest_count"
        },
        {
          "key": "tables",
          "$comment": "Round tables seat 10.",
          "product": { "sku": "FURN-TABLE-ROUND" },
          "quantity": "ceil(guest_count / 10)"
        }
      ]
    }
  ]
}
