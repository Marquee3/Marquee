# Copy to .env for the local commands (npm run check / setup / plan / sync) and
# for running on a Node host. On Cloudflare, use `npx wrangler secret put` instead.

# Access token of the HubSpot app (legacy private app token, or the static
# access token of a project-based app). Starts with "pat-".
HUBSPOT_ACCESS_TOKEN=

# --- Node host only below. Optional: webhooks for instant updates. Without them
# the service checks HubSpot for changed deals every SYNC_POLL_SECONDS.

# The app's client secret, used to verify that webhooks really come from HubSpot.
HUBSPOT_CLIENT_SECRET=

# The public base URL HubSpot calls, e.g. https://line-items.example.com.
# Needed to verify webhook signatures behind a proxy or load balancer.
PUBLIC_URL=

# Optional: only accept webhooks from this HubSpot account ID.
HUBSPOT_PORTAL_ID=

# Optional: enables POST /sync (e.g. from a workflow "Send a webhook" action).
# Use a long random value.
SYNC_API_KEY=

# Optional tuning.
# PORT=3000
# SYNC_POLL_SECONDS=60            # 0 = webhooks only
# SYNC_POLL_LOOKBACK_MINUTES=60   # how far back to look on startup
# SYNC_DEBOUNCE_MS=5000
# SYNC_CONCURRENCY=2
# CONFIG_DIR=config
# HUBSPOT_API_VERSION=2026-09     # or "legacy" for the old numbered APIs
